{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "vesta Linux Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VESTA_OUTPUT_NAME": "vesta"
      }
    },
    {
      "name": "linux-release",
      "displayName": "vesta Linux Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VESTA_OUTPUT_NAME": "vesta"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "debug",
      "displayName": "vesta Debug (console)",
      "description": "Debug build with console and diagnostics",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "release",
      "displayName": "vesta Release (clean)",
      "description": "Optimized release build without the console module",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "VESTA_PERF_LOG": "OFF",
        "VESTA_WINDOWED_PROFILE": "OFF",
        "VESTA_WINDOWED_SESSION": "OFF",
        "VESTA_OUTPUT_NAME": "vesta"
      }
    },
    {
      "name": "profile",
      "displayName": "vesta optimized CPU profiling",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/profile",
      "cacheVariables": {
        "VESTA_PERF_LOG": "ON",
        "VESTA_OUTPUT_NAME": "vesta-profile"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "displayName": "Build vesta Linux Debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "displayName": "Build vesta Linux Release",
      "configurePreset": "linux-release"
    },
    {
      "name": "debug",
      "displayName": "Build vesta Debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build vesta Release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "profile",
      "displayName": "Build vesta Profile",
      "configurePreset": "profile",
      "configuration": "Release"
    }
  ]
}
